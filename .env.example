# Copier ce fichier en .env puis remplir. Ne JAMAIS committer .env.
#   cp .env.example .env

# --- OpenAI (obligatoire pour les steps 1, 2, 3, 5, 9) ---
OPENAI_API_KEY=
# Modèle utilisé partout dans le workshop. Vérifier qu'il existe encore :
# https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4.1-mini

# --- Claude / Anthropic (optionnel : steps *_bis ; sans clé elles sont sautées) ---
# https://platform.claude.com/ -> API keys. Voir resources/ANTHROPIC_API_KEY.md
ANTHROPIC_API_KEY=
# Modèle par défaut : claude-opus-5-5 (4 $ / 20 $ par million de tokens entrée/sortie).
# Moins cher : claude-sonnet-5-5 (2 $ / 10 $) ou claude-haiku-5-5 (0,10 $ / 0,50 $).
ANTHROPIC_MODEL=claude-opus-5-5
# Profondeur de réflexion : low | medium | high | xhigh | max (low suffit pour le workshop)
ANTHROPIC_EFFORT=low

# --- Hugging Face (optionnel : les modèles publics marchent sans token) ---
HUGGING_FACE_API_KEY=

# --- Ollama (modèles locaux, téléchargés automatiquement par docker compose) ---
OLLAMA_SMALL_MODEL=llama3.2:1b
OLLAMA_MEDIUM_MODEL=llama3.2:3b
